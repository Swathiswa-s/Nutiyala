[Unit]
Description=Nutiyala Couture Backend Service
After=network.target

[Service]
Type=simple
User=nutiyala
Group=nutiyala
WorkingDirectory=/var/www/nutiyala_couture
EnvironmentFile=/etc/nutiyala/nutiyala.env
ExecStart=/usr/bin/python3 /var/www/nutiyala_couture/serve.py
Restart=always
RestartSec=5s

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/nutiyala /var/backups/nutiyala /var/www/nutiyala_couture/uploads

# Resource Limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
