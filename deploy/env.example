# ==============================================================================
# Nutiyala Couture - Production Environment Configuration Template
# Store this file in a restricted path (e.g. /etc/nutiyala/nutiyala.env)
# Permissions must be restricted: sudo chmod 0600 /etc/nutiyala/nutiyala.env
# ==============================================================================

# Server network binding (ALWAYS bind to 127.0.0.1 behind Nginx reverse proxy)
HOST=127.0.0.1
PORT=5173

# Approved CORS Origins (Comma-separated list of exact protocol + domain)
ALLOWED_ORIGIN=https://nutiyalacouture.com,https://www.nutiyalacouture.com

# Database persistence paths (persistent directory owned by nutiyala user)
NUTIYALA_DB_PATH=/var/lib/nutiyala/nutiyala.db
NUTIYALA_BACKUP_DIR=/var/backups/nutiyala/db
NUTIYALA_BACKUP_RETENTION_DAYS=14

# SMS Gateway Provider ('fast2sms' or 'twilio')
SMS_PROVIDER=fast2sms

# Fast2SMS Gateway Configuration
# 1. FAST2SMS_API_KEY: Your Fast2SMS Authorization key from https://www.fast2sms.com/dashboard/dev-api
#    Never commit or expose this key. If left blank, the system operates in SIMULATED_LOCAL mode.
FAST2SMS_API_KEY=

# 2. FAST2SMS_LIVE_DISPATCH: Master toggle for real carrier SMS transmission.
#    Set to 'true' in production to dispatch real SMS via Fast2SMS bulkV2 gateway.
#    Set to 'false' (default) in development/staging to simulate delivery and protect wallet balance.
FAST2SMS_LIVE_DISPATCH=false

# 3. FAST2SMS Route configuration ('q' for Quick SMS, 'dlt' for TRAI DLT approved templates)
FAST2SMS_ROUTE=q
FAST2SMS_SENDER_ID=
FAST2SMS_ENTITY_ID=


# Primary administrator phone number for order alerts (Indian 10-digit mobile or +91 format)
ADMIN_NOTIFICATION_PHONE=+919876543210

